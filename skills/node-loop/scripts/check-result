#!/usr/bin/env bash
# check-result: the gates every implementer result passes before review, in one call.
#
# Usage: check-result <run-dir> <node-id> <round> <base> <head>
# Order: leak-check (REPO must hold no implementer writes), then fence-check on <base>..<head>.
# Exit 0: clean, go on to review.
# Exit 1: violation, kick back. Prints the violating paths, one per line. This script has already
#         written the `fence` ledger line and captured reviews/<id>-r<round>.patch; a leak was stashed
#         out of REPO by leak-check. The orchestrator dispatches the next implementer with FENCE_VIOLATIONS.
# Exit 2: usage or input error, or a leak that could not be stashed; the orchestrator stops.
# Violations kick back even when the implementer reported status blocked, because a blocked
# implementer can still have written outside its fence or into REPO.
set -euo pipefail

usage() {
  printf 'check-result: %s\n' "$1" >&2
  printf '%s\n' "usage: check-result <run-dir> <node-id> <round> <base> <head>" >&2
  exit 2
}

[ "$#" -eq 5 ] || usage "expected 5 arguments"
run_dir=$1
node_id=$2
round=$3
base=$4
head=$5

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
NODE_RE='^[0-9]{2}-[a-z0-9-]+$'
[ -d "$run_dir" ] || usage "run dir not found: $run_dir"
[[ "$node_id" =~ $NODE_RE ]] || usage "invalid plan node id: $node_id"
case "$round" in
  '' | *[!0-9]* | 0) usage "round must be a positive integer: $round" ;;
esac

run_dir=$(cd "$run_dir" && pwd)
REPO=""
# shellcheck disable=SC1091
. "$run_dir/meta.env"
[ -n "$REPO" ] || usage "REPO is empty in $run_dir/meta.env"
[ -d "$REPO" ] || usage "REPO not found: $REPO"

git -C "$REPO" rev-parse -q --verify "$base^{commit}" >/dev/null || usage "unknown base revision: $base"
git -C "$REPO" rev-parse -q --verify "$head^{commit}" >/dev/null || usage "unknown head revision: $head"

# Records the violation and prints its paths for the orchestrator; never returns.
kick_back() {
  local paths=$1 count
  count=$(printf '%s\n' "$paths" | grep -c . || true)
  "$SCRIPT_DIR/ledger" "$run_dir" "$node_id" fence "round=$round" "paths=$count" -- "$(printf '%s\n' "$paths" | paste -sd, -)"
  # review-package only captures the .patch for the next implementer; its path output is not needed.
  "$SCRIPT_DIR/review-package" "$run_dir" "$node_id" "$round" "$base" "$head" >/dev/null
  printf '%s\n' "$paths"
  exit 1
}

leak_rc=0
leaked=$("$SCRIPT_DIR/leak-check" "$run_dir" "$node_id" "$round") || leak_rc=$?
case "$leak_rc" in
  0) ;;
  1) kick_back "$leaked" ;;
  *) exit 2 ;;
esac

fence_rc=0
violations=$(cd "$REPO" && "$SCRIPT_DIR/fence-check" "$run_dir/nodes/$node_id.md" "$base" "$head") || fence_rc=$?
case "$fence_rc" in
  0) exit 0 ;;
  1) kick_back "$violations" ;;
  *) exit 2 ;;
esac
